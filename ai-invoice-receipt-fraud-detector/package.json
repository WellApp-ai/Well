    "analyze": "pnpm exec tsx packages/cli/src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^5.23.2",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "^7.0.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.11",
    "bun-types": "^1.4.2",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
