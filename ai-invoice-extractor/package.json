{
  "name": "ai-invoice-extractor",
  "description": "AI-based invoice & receipt data extractor.",
  "version": "0.3.0",
  "author": "Well App Team <bastien@wellapp.ai>",
  "license": "MIT",
  "type": "module",
  "main": "dist/cli",
  "bin": {
    "ai-invoice-extractor": "dist/cli"
  },
  "keywords": [
    "ai",
    "invoice",
    "receipt",
    "extractor",
    "openai",
    "mistral",
    "google",
    "gemini",
    "cli"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target bun --compile --outfile dist/cli",
    "publish": "npm publish",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.24",
    "@types/dotenv": "^6.1.1",
    "ai": "^7.0.93",
    "bun-types": "^1.2.19",
    "commander": "^14.0.3",
    "dotenv": "^16.6.1",
    "figlet": "^1.11.4",
    "ollama-ai-provider": "^1.2.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.20.1",
    "bun-types": "^1.4.2",
    "@vitest/ui": "^3.2.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "homepage": "https://github.com/WellApp-ai/Well#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WellApp-ai/Well.git"
  },
  "bugs": {
    "url": "https://github.com/WellApp-ai/Well/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "jsondiffpatch": "0.7.6",
    "nanoid": "3.3.18"
  }
}
